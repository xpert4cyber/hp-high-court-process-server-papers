        "subject":  "Reasoning",
        "topic":  "Calendar \u0026 Time",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "If 1st January was a Monday, what day was 8th January of the same month?",
        "options":  [
                        "Sunday",
                        "Monday",
                        "Tuesday",
                        "Wednesday"
                    ],
        "correctAnswer":  1,
        "explanation":  "Days of the week repeat every 7 days: 1 + 7 = 8, so 8th January is also Monday.",
        "source":  "Calendar Reasoning",
        "verification":  "reviewed"
