        "subject":  "Reasoning",
        "topic":  "Odd One Out",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "Find the odd one out among the given words:",
        "options":  [
                        "Carrot",
                        "Potato",
                        "Tomato",
                        "Radish"
                    ],
        "correctAnswer":  2,
