        "source":  "Classification Reasoning",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-008",
        "subject":  "Reasoning",
        "topic":  "Number Classification",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "Which of the following numbers does not belong to the group: 4, 9, 16, 25, 35, 49?",
        "options":  [
                        "9",
                        "16",
                        "35",
                        "49"
                    ],
        "correctAnswer":  2,
        "explanation":  "All numbers are perfect squares (2^2, 3^2, 4^2, 5^2, 7^2) except 35.",
        "source":  "Number Reasoning",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-009",
        "subject":  "Reasoning",
        "topic":  "Ranking \u0026 Order",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "In a row of 25 students, Priya is 10th from the left. What is her rank from the right end?",
        "options":  [
                        "15th",
                        "16th",
                        "17th",
                        "14th"
                    ],
        "correctAnswer":  1,
        "explanation":  "Rank from right = Total students - Rank from left + 1 = 25 - 10 + 1 = 16th.",
        "source":  "Order \u0026 Ranking Problems",
        "verification":  "reviewed"
    },
    {
