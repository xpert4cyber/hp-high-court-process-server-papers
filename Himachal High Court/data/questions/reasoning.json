[
    {
        "id":  "RSN-001",
        "subject":  "Reasoning",
        "topic":  "Number Series",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "What comes next in the sequence: 5, 10, 15, 20, 25, ?",
        "options":  [
                        "28",
                        "30",
                        "32",
                        "35"
                    ],
        "correctAnswer":  1,
        "explanation":  "The series increases by adding 5 in each step: 25 + 5 = 30.",
        "source":  "Mental Ability Test",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-002",
        "subject":  "Reasoning",
        "topic":  "Alphabet Series",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "Find the next letter in the series: B, D, F, H, ?",
        "options":  [
                        "I",
                        "J",
                        "K",
                        "L"
                    ],
        "correctAnswer":  1,
        "explanation":  "Letters skip one position each time (+2): B(2), D(4), F(6), H(8), J(10).",
        "source":  "Logical Reasoning Standard",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-003",
        "subject":  "Reasoning",
        "topic":  "Analogy",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "\u0027Pen\u0027 is to \u0027Write\u0027 as \u0027Knife\u0027 is to:",
        "options":  [
                        "Shoot",
                        "Cut",
                        "Sharp",
                        "Cook"
                    ],
        "correctAnswer":  1,
        "explanation":  "A pen is an instrument used to write; a knife is an instrument used to cut.",
        "source":  "Verbal Analogy",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-004",
        "subject":  "Reasoning",
        "topic":  "Blood Relations",
        "difficulty":  "moderate",
        "language":  "en",
        "question":  "Pointing to a photograph, Rohit said, \u0027She is the daughter of my grandfather\u0027s only son.\u0027 How is Rohit related to the girl?",
        "options":  [
                        "Brother",
                        "Uncle",
                        "Father",
                        "Cousin"
                    ],
        "correctAnswer":  0,
        "explanation":  "Grandfather\u0027s only son is Rohit\u0027s father. The daughter of Rohit\u0027s father is Rohit\u0027s sister. Hence, Rohit is her brother.",
        "source":  "Standard Reasoning Practice",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-005",
        "subject":  "Reasoning",
        "topic":  "Coding-Decoding",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "If in a certain code \u0027APPLE\u0027 is written as \u0027BQQMF\u0027, how is \u0027MANGO\u0027 written?",
        "options":  [
                        "NBOIP",
                        "NBOHP",
                        "OCPIP",
                        "MBOHP"
                    ],
        "correctAnswer":  1,
        "explanation":  "Each letter is shifted by +1: M-\u003eN, A-\u003eB, N-\u003eO, G-\u003eH, O-\u003eP = \u0027NBOHP\u0027.",
        "source":  "Coding-Decoding Basics",
        "verification":  "reviewed"
    },
    {
        "id":  "RSN-006",
        "subject":  "Reasoning",
        "topic":  "Direction Sense",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "If a person faces South and turns 90 degrees clockwise, which direction is he facing now?",
        "options":  [
                        "East",
                        "West",
                        "North",
                        "South-West"
                    ],
        "correctAnswer":  1,
        "explanation":  "Clockwise rotation from South points toward the West.",
        "source":  "Spatial Reasoning",
        "verification":  "reviewed"
    },
