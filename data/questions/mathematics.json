        "options":  [
                        "36 cm",
                        "40 cm",
                        "44 cm",
                        "96 cm"
                    ],
        "correctAnswer":  1,
        "explanation":  "Perimeter = 2 * (length + breadth) = 2 * (12 + 8) = 2 * 20 = 40 cm.",
        "source":  "10+2 Arithmetic Standard",
