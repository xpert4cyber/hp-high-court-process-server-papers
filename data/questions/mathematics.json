        "topic":  "Time and Work",
        "difficulty":  "moderate",
        "language":  "en",
        "question":  "12 men can finish a piece of work in 15 days. In how many days can 20 men finish the same work?",
        "options":  [
                        "8 days",
                        "9 days",
                        "10 days",
                        "12 days"
                    ],
        "correctAnswer":  1,
        "explanation":  "Using M1 * D1 = M2 * D2: 12 * 15 = 20 * D2 =\u003e 180 = 20 * D2 =\u003e D2 = 9 days.",
        "source":  "10+2 Arithmetic Standard",
        "verification":  "reviewed"
    },
