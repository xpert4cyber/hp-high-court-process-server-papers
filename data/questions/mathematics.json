        "topic":  "Profit and Loss",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "An item bought for Rs. 250 is sold for Rs. 300. What is the profit percentage?",
        "options":  [
                        "15%",
                        "20%",
                        "25%",
                        "30%"
                    ],
        "correctAnswer":  1,
        "explanation":  "Profit = 300 - 250 = Rs. 50. Profit % = (50 / 250) * 100 = (1 / 5) * 100 = 20%.",
        "source":  "10+2 Arithmetic Standard",
        "verification":  "reviewed"
    },
