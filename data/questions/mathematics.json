        "id":  "MATH-005",
        "subject":  "Mathematics",
        "topic":  "Simple Interest",
        "difficulty":  "easy",
        "language":  "en",
        "question":  "Calculate the simple interest on Rs. 5,000 for 2 years at an annual interest rate of 6%.",
        "options":  [
                        "Rs. 500",
                        "Rs. 600",
                        "Rs. 700",
                        "Rs. 800"
                    ],
        "correctAnswer":  1,
        "explanation":  "SI = (Principal * Rate * Time) / 100 = (5000 * 6 * 2) / 100 = 600 Rs.",
        "source":  "10+2 Arithmetic Standard",
        "verification":  "reviewed"
    },
    {
        "id":  "MATH-006",
