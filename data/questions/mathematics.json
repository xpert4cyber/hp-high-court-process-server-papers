        "question":  "The average of four numbers is 20. If three of them are 15, 22, and 25, find the fourth number.",
        "options":  [
                        "16",
                        "18",
                        "20",
                        "22"
                    ],
        "correctAnswer":  1,
        "explanation":  "Total sum = 4 * 20 = 80. Sum of 3 numbers = 15 + 22 + 25 = 62. Fourth number = 80 - 62 = 18.",
        "source":  "10+2 Arithmetic Standard",
        "verification":  "reviewed"
    },
